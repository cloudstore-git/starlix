{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "types": ["node"]
  },
  "include": ["infra/**/*.ts", "services/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
